# Copy this to .env and fill in real values. Never commit .env.

PORT=4000
FRONTEND_URL=http://localhost:3000

# Stripe (test mode keys to start — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Admin page password for the Ask a Surveyor review-code lookup (section 14).
# Replace with real auth before launch — this is a minimal placeholder.
ADMIN_PASSWORD=change-me

# Email sending (section 16/17). Fill in once a provider is chosen.
# Any SMTP-compatible provider works; Brevo also offers a transactional API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDING_ADDRESS=support@asbestosadvice.uk

# Brevo (checklist lead capture — section 18) TO CONFIRM as the platform
BREVO_API_KEY=
BREVO_LIST_ID=

# Secure download storage (section 11). Point this at wherever the final PDF
# lives privately — e.g. an S3/GCS bucket the app has read access to. Never
# a public URL.
PRODUCT_FILE_PATH=./private/Asbestos-Answered_2026-UK-Edition.pdf
DOWNLOAD_LINK_EXPIRY_HOURS=72
DOWNLOAD_MAX_USES=5

# Meta Conversions API (section 20) TO CONFIRM: pixel ID + access token
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
